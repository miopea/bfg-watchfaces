build/
.gradle/
local.properties
*.apk
*.idsig
.idea/
*.iml
.DS_Store

# Fetched by scripts/bootstrap.sh, not ours to redistribute
generator/libs/
generator/src/test/resources/wff-schema/
watchface-template/tools/wff-schema/
watchface-template/tools/libs/
watchface-template/tools/*.class

# Generated, not source. The workbench or the generator produces these.
watchface-template/res/drawable-nodpi/*.png

# Generated on first build by build.sh. Signs throwaway dev faces only.
debug.keystore

# Faces you design and save in the app. Personal work, not repo content -- the
# community catalog is a curated set, not whatever is on someone's laptop.
#
# ANCHORED with a leading slash on purpose. An unanchored `faces/` matches any
# directory of that name at any depth, which silently swallowed catalog/faces/
# and pushed an index.json describing seven faces that were not committed.
/faces/

# Images imported for the TEXTURE engine. Local content, never part of a face
# and never publishable -- the catalog is parameters only.
textures/
