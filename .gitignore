build/
.gradle/
local.properties
*.apk
*.idsig
.idea/
*.iml
.DS_Store

# Fetched by scripts/bootstrap.sh, not ours to redistribute
generator/libs/
generator/src/test/resources/wff-schema/
watchface-template/tools/wff-schema/
watchface-template/tools/libs/
watchface-template/tools/*.class

# Generated, not source. The workbench or the generator produces these.
watchface-template/res/drawable-nodpi/*.png

# Generated on first build by build.sh. Signs throwaway dev faces only.
debug.keystore

# Faces you design and save in the app. Personal work, not repo content -- the
# community catalog is a separate public repository, and a curated set rather
# than whatever is on someone's laptop:
#   https://github.com/miopea/bfg-watchfaces-catalog
#
# ANCHORED with a leading slash on purpose. An unanchored `faces/` matches any
# directory of that name at any depth, which once silently swallowed a
# catalog/faces/ directory and pushed an index describing faces that were not
# committed. Anchor these patterns.
/faces/

# Whether this install has been asked about activation. Per-install state, like
# /faces/, not source -- and anchored for the same reason.
/activation.txt

# Images imported for the TEXTURE engine. Local content, never part of a face
# and never publishable -- the catalog is parameters only.
textures/

# Signing material. The upload keystore lives in ~/.keystores and its password
# is in 1Password; neither may ever be committed.
*.jks
*.keystore
keystore.properties

# Built by scripts/build-pack-android.sh from pinned, patched google/pack.
# Build output, not source -- and not Androidify's prebuilt binaries either.
mobile/src/main/jniLibs/

# Rust build output for the JNI wrapper.
scripts/pack-java/target/

# Python bytecode from scripts/ (play-release.py is imported by ad-hoc checks).
__pycache__/
*.pyc

# The catalog service's dependencies. package-lock.json IS committed, so an
# install is reproducible; node_modules is 100MB of somebody else's code and
# carries the workerd binary for whichever platform ran npm install.
catalog-service/node_modules/
catalog-service/.wrangler/
