<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="1"
    android:versionName="1.0"
    package="com.bfg.watchfaces.watchfacepush.glow_100">

  <!--
    Declared HERE rather than only as aapt2 link flags, so the manifest fully
    describes the package. google/pack reads the manifest and takes no SDK
    flags, and neither will the on-device build; without these an APK comes out
    with no versionCode and an implied targetSdk below 4, which makes apksigner
    demand a v1 JAR signature that a v3-only signer does not produce.

    uses-sdk is on Watch Face Push's permitted-tag list. See docs/SPEC.md.
  -->
  <uses-sdk android:minSdkVersion="33" android:targetSdkVersion="34" />

  <uses-feature android:name="android.hardware.type.watch" />

  <!-- hasCode MUST be false. A Watch Face Format face contains no executable code. -->
  <application
      android:label="@string/watch_face_name"
      android:hasCode="false">

    <meta-data
        android:name="com.google.android.wearable.standalone"
        android:value="true" />

    <!-- WFF feature level. 2 is safe on Wear OS 5 and up.
         Raise to 5 only once both watches are on Wear OS 7. -->
    <property
        android:name="com.google.wear.watchface.format.version"
        android:value="2" />
  </application>
</manifest>
