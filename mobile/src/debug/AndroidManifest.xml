<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!--
    Debug only. Lets adb drive the pack pipeline with no UI, the same way
    :wear's DebugInstallReceiver drives Watch Face Push. It is not in the
    release manifest and cannot be.
  -->
  <application>
    <receiver
        android:name=".DebugPackReceiver"
        android:exported="true">
      <intent-filter>
        <action android:name="com.bfg.watchfaces.DEBUG_PACK" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
