<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!--
    The DESIGN app. It explains the activation handoff and sends faces; it never
    asks for the activation permission, because it cannot hold it.

    androidx.wear.watchfacepush declares <uses-library wear-sdk required="true">,
    so any app linking it will not install on a phone or tablet at all. The
    permission is checked inside setWatchFaceAsActive on the WATCH. Google's own
    guidance gives the watch app the job of "requesting necessary permissions and
    prompting the user".

    See DECISIONS.md 2026-08-28 and docs/SPEC.md, "Why there are two apps".
  -->

  <uses-permission android:name="android.permission.INTERNET" />

  <!--
    The day of her cycle, read from Health Connect and shown on her own watch.

    READ only. There is no WRITE permission of any kind here and the app never
    writes to Health Connect. One record type is read, MenstruationPeriodRecord,
    and one field is taken from it: the start of the most recent period. See
    CycleSource, which is the only code that touches it, and
    docs/specs/cycle-complication-declarations.md for what Google was told.

    The WATCH app holds no health permission at all. It receives a date.
  -->
  <uses-permission android:name="android.permission.health.READ_MENSTRUATION" />

  <!--
    Health Connect shipped as an installable app before Android 14 and as part
    of the platform from 14 onward. On API 28 to 33 it is a separate package,
    and package visibility means we cannot see it, ask it for permissions, or
    open its settings without naming it here.
  -->
  <queries>
    <package android:name="com.google.android.apps.healthdata" />
  </queries>

  <application
      android:label="BFG Watch Faces"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:supportsRtl="true"
      android:theme="@style/Theme.BfgWatchFaces">
    <activity
        android:name=".MainActivity"
        android:exported="true"
        android:theme="@style/Theme.BfgWatchFaces">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <!--
        So the WATCH can open this app. RemoteActivityHelper hands the phone an
        ACTION_VIEW intent, and without something to view it can only open the
        Play listing, which for an app already installed is a page with an
        "Open" button on it, one tap short of useful.

        A private scheme rather than an https App Link: an App Link needs
        assetlinks.json served from a verified domain, and the only caller is a
        watch we also wrote. There is nothing here worth a domain round trip.
      -->
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="bfgwatchfaces" android:host="open" />
      </intent-filter>
    </activity>

    <!--
      Where Health Connect sends somebody who asks WHY this app wants her
      period data. Both of these are required and they are required on
      DIFFERENT Android versions, which is why there are two.

      Android 14 and up: the platform Health Connect opens
      VIEW_PERMISSION_USAGE, guarded by START_VIEW_PERMISSION_USAGE so only the
      system can launch it.

      Android 13 and below: the Health Connect APK opens the older
      SHOW_PERMISSIONS_RATIONALE action instead.

      Both land on MainActivity. The app has one screen stack and the honest
      answer lives in it, next to the switch that turns the feature on. A
      separate page that exists only to be linked to from a system dialog is a
      page nobody maintains.
    -->
    <activity-alias
        android:name=".ViewPermissionUsageActivity"
        android:exported="true"
        android:targetActivity=".MainActivity"
        android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
      <intent-filter>
        <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
        <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
      </intent-filter>
    </activity-alias>

    <activity-alias
        android:name=".PermissionsRationaleActivity"
        android:exported="true"
        android:targetActivity=".MainActivity">
      <intent-filter>
        <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
      </intent-filter>
    </activity-alias>

  </application>
</manifest>
