<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!--
    The DESIGN app. It explains the activation handoff and sends faces; it never
    asks for the activation permission, because it cannot hold it.

    androidx.wear.watchfacepush declares <uses-library wear-sdk required="true">,
    so any app linking it will not install on a phone or tablet at all. The
    permission is checked inside setWatchFaceAsActive on the WATCH. Google's own
    guidance gives the watch app the job of "requesting necessary permissions and
    prompting the user".

    See DECISIONS.md 2026-08-28 and docs/SPEC.md, "Why there are two apps".
  -->

  <uses-permission android:name="android.permission.INTERNET" />

  <application
      android:label="BFG Watch Faces"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:supportsRtl="true"
      android:theme="@style/Theme.BfgWatchFaces">
    <activity
        android:name=".MainActivity"
        android:exported="true"
        android:theme="@style/Theme.BfgWatchFaces">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <!--
        So the WATCH can open this app. RemoteActivityHelper hands the phone an
        ACTION_VIEW intent, and without something to view it can only open the
        Play listing, which for an app already installed is a page with an
        "Open" button on it, one tap short of useful.

        A private scheme rather than an https App Link: an App Link needs
        assetlinks.json served from a verified domain, and the only caller is a
        watch we also wrote. There is nothing here worth a domain round trip.
      -->
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="bfgwatchfaces" android:host="open" />
      </intent-filter>
    </activity>
  </application>
</manifest>
